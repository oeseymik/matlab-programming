%%2번
clear; clc;

n=3000;%a

interArrival=exprnd(1.2,1,n);%b

arrival=cumsum(interArrival);%c

service=exprnd(0.9,1,n);%d

startTime=zeros(1,n);
finishTime=zeros(1,n);

for i=1:n
    if i==1
        startTime(i)=arrival(i);
    else
        startTime(i)=max(arrival(i),finishTime(i-1));
    end
    finishTime(i)=startTime(i)+service(i);
end%e

waitingTime=startTime-arrival;%f

meanWait=mean(waitingTime);
maxWait=max(waitingTime);
longWaitRatio=mean(waitingTime>=5);%g

figure
histogram(waitingTime,40);%h
title('Waiting Time Distribution in a Data Center Queue');%i

