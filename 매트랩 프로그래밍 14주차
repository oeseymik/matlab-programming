clear; clc;

rng(7)%a

t=linspace(0,30,300);%b

trueSignal=2*sin(0.4*t)+0.7*cos(1.5*t);%c

obsSignal=trueSignal+0.25*randn(size(t));%d

idx=randperm(length(t),45);
obsSignal(idx)=NaN;%e

valid=~isnan(obsSignal);%f

recLinear=interp1(t(valid),obsSignal(valid),t,'linear');%g

recSpline=interp1(t(valid),obsSignal(valid),t,'spline');%h

rmseLinear = sqrt(mean((trueSignal-recLinear).^2));
rmseSpline = sqrt(mean((trueSignal-recSpline).^2));%i

figure
plot(t,trueSignal,'b');
hold on
plot(t,obsSignal,'r');
plot(t,recLinear,'y');
plot(t,recSpline,'g');

legend('trueSignal','obsSignal','recLinear','recSpline')%j

