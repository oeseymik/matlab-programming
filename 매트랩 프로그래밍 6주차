clear; clc;

connect=input('직렬 또는 병렬을 입력하세요','s');
n=input('저항의 개수를 입력하세요:');
resistance=zeros(1,n);
totalresistance=0;

for k=1:n
    resistance(k) = input('저항 값을 입력하세요: ');
end

if connect=="직렬"
        totalresistance = sum(resistance);
elseif connect=="병렬"
        totalresistance = 1/sum(1./resistance);
else
        fprintf('직렬 또는 병렬을 입력해야 합니다.\n')
end

    fprintf('총 저항 값: %.2f옴\n', totalresistance);
