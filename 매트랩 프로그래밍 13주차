clear; clc;

n = 50000;

pass1 = rand(n,1) < 0.94;

pass2 = false(n,1);
idx1 = find(pass1);
pass2(idx1) = rand(length(idx1),1) < 0.91;

pass3 = false(n,1);
idx2 = find(pass1 & pass2);
pass3(idx2) = rand(length(idx2),1) < 0.88;

finalPass = pass1 & pass2 & pass3;

fprintf('최종 합격률 = %.4f\n',mean(finalPass))

fail1 = sum(~pass1);
fail2 = sum(pass1 & ~pass2);
fail3 = sum(pass1 & pass2 & ~pass3);
passFinal = sum(finalPass);

bar([fail1 fail2 fail3 passFinal])
xticklabels({'Fail1','Fail2','Fail3','Pass'})
