7번
clear; clc;

arrivalGap = exprnd(8,300,1);
arrivalTime = cumsum(arrivalGap);

serviceTime = 10 + 3*randn(300,1);
serviceTime(serviceTime<0) = 1;

startTime = zeros(300,1);
finishTime = zeros(300,1);

startTime(1) = arrivalTime(1);
finishTime(1) = startTime(1) + serviceTime(1);

for k = 2:300
    startTime(k) = max(arrivalTime(k),finishTime(k-1));
    finishTime(k) = startTime(k) + serviceTime(k);
end

waitTime = startTime - arrivalTime;

fprintf('평균 대기시간 = %.4f\n',mean(waitTime))
fprintf('최대 대기시간 = %.4f\n',max(waitTime))
fprintf('20분 초과 비율 = %.4f\n',mean(waitTime>20))

histogram(waitTime)
xlabel('Waiting Time')
ylabel('Count')
