clear; clc;
rng(13)

p = 0.35 + (0.95-0.35)*rand(1,40);

R = rand(5000,40);
correct = R < p;

score = sum(correct,2);

avgScore = mean(score);
stdScore = std(score);

fprintf('평균 점수 = %.4f\n',avgScore)
fprintf('표준편차 = %.4f\n',stdScore)

histogram(score)
xlabel('Score')
ylabel('Count')

ratio = mean(score >= avgScore);
fprintf('평균 이상 비율 = %.4f\n',ratio)
