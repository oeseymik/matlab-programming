#include <stdio.h>
#include <stdlib.h>
 
int main() {
    int t;
    scanf("%d", &t);
 
    while (t--) {
 
        int n;
        scanf("%d", &n);
 
        long long a[200005];
 
        for (int i = 0; i < n; i++) {
            scanf("%lld", &a[i]);
        }
 
        long long ans;
 
        if (a[0] != -1 && a[n-1] != -1) {
            ans = llabs(a[n-1] - a[0]);
        }
 
        else {
            ans = 0;
 
            if (a[0] == -1 && a[n-1] != -1) {
                a[0] = a[n-1];
            }
 
            else if (a[0] != -1 && a[n-1] == -1) {
                a[n-1] = a[0];
            }
 
            else {
                a[0] = 0;
                a[n-1] = 0;
            }
        }
 
        for (int i = 0; i < n; i++) {
            if (a[i] == -1) {
                a[i] = 0;
            }
        }
 
        printf("%lld\n", ans);
 
        for (int i = 0; i < n; i++) {
            printf("%lld ", a[i]);
        }
 
        printf("\n");
    }
 
    return 0;
}

//2149C
#include <stdio.h>
 
int cnt[200005];
 
int main() {
 
    int t;
    scanf("%d", &t);
 
    while (t--) {
 
        int n, k;
        scanf("%d %d", &n, &k);
 
        for (int i = 0; i <= n; i++) {
            cnt[i] = 0;
        }
 
        for (int i = 0; i < n; i++) {
            int x;
            scanf("%d", &x);
            cnt[x]++;
        }
 
        int missing = 0;
 
        for (int i = 0; i < k; i++) {
            if (cnt[i] == 0) {
                missing++;
            }
        }
 
        int ans;
 
        if (missing > cnt[k]) {
            ans = missing;
        }
        else {
            ans = cnt[k];
        }
 
        printf("%d\n", ans);
    }
 
    return 0;
}

