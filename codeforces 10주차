#include <stdio.h>

int main() {
    int arr[7];
    int n;
    scanf("%d",&n);

    for(int i=0;i<n;i++){
        for(int j=0;j<7;j++){
            scanf("%d",&arr[j]);
        }//숫자 7개 입력받음

        for(int j=0;j<7;j++){
            for(int k=0;k<7-j-1;k++){
                if(arr[k]>arr[k+1]){
                    int tmp=arr[k];
                    arr[k]=arr[k+1];
                    arr[k+1]=tmp;
                }
            }
        }

        for(int j=0;j<6;j++){
            arr[j]=arr[j]*-1;
        }

        int sum=0;
        for(int j=0;j<7;j++){
            sum=sum+arr[j];
        }
        printf("%d\n",sum);
    }
    return 0;
    

    
}

