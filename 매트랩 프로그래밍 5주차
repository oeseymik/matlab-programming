//2번
name=input('이름 입력하세요 :','s')
score=input('점수 입력하세요 :')
score_avg=sum(score)/3;
fprintf('%s %d %d %d %.2f\n',name,score(1),score(2),score(3),score_avg)

if score_avg>=90
    fprintf('Excellent\n')
elseif score_avg>=80&&score_avg<90
        fprintf('Good\n')
elseif score_avg>=70&&score_avg<80
        fprintf('Fair\n')
elseif score_avg<70
        fprintf('Needs Improvement\n')
end
      

