clear; clc;

t=linspace(0,24,1000);
T=15+10.*sin((pi.*t)/12);

figure
plot(t,T)
xlabel('t')
ylabel('T(t)')
title('temperture variation')
grid on

hold on

[Tmax, idx_max] = max(T);
[Tmin, idx_min] = min(T);

t_max = t(idx_max);
t_min = t(idx_min);

text(t_max,Tmax,' Max','Color','r')
text(t_min,Tmin,' Min','Color','b')
fprintf('최고온도:%f,최저온도:%f\n',Tmax,Tmin)

